<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net"><diagram id="request-flow" name="Request flow"><mxGraphModel dx="1440" dy="1660" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1490" pageHeight="1700" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;One request: reserve → infer → settle&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=30;fontColor=#243746;" vertex="1" parent="1"><mxGeometry x="60" y="35" width="1300" height="60" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Supported POC: Entra-authenticated, non-streaming text Chat Completions, one response, explicit output cap." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#243746;" vertex="1" parent="1"><mxGeometry x="60" y="105" width="1300" height="45" as="geometry"/></mxCell>
<mxCell id="start" value="&lt;b&gt;1 · Consumer sends a request to APIM&lt;/b&gt;&lt;br&gt;Delegated Entra token + text prompt + output cap" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;spacing=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="445" y="185" width="550" height="85" as="geometry"/></mxCell>
<mxCell id="jwt" value="&lt;b&gt;2 · APIM validates identity and route&lt;/b&gt;&lt;br&gt;JWT issuer / audience / tenant&lt;br&gt;Extract user / group claims from the validated token" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="445" y="325" width="550" height="105" as="geometry"/></mxCell>
<mxCell id="precheck" value="&lt;b&gt;3 · APIM → engine: access precheck&lt;/b&gt;&lt;br&gt;Redis: cached access configuration + rate counters&lt;br&gt;Cache miss: configuration read from PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="445" y="485" width="550" height="105" as="geometry"/></mxCell>
<mxCell id="reserve" value="&lt;b&gt;4 · APIM → engine: validate and reserve&lt;/b&gt;&lt;br&gt;Validate text body, output cap and matching identities&lt;br&gt;PostgreSQL: check every allowance in one transaction&lt;br&gt;Reserve hard input bound + capped output at approved prices" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;spacing=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="445" y="645" width="550" height="115" as="geometry"/></mxCell>
<mxCell id="decision" value="&lt;b&gt;5 · Funds available&lt;br&gt;in every bucket?&lt;br&gt;spent + reserved +&lt;br&gt;new maximum ≤ limit&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shape=rhombus;" vertex="1" parent="1"><mxGeometry x="540" y="805" width="360" height="175" as="geometry"/></mxCell>
<mxCell id="deny" value="&lt;b&gt;APIM returns HTTP 429&lt;/b&gt;&lt;br&gt;budget_exceeded&lt;br&gt;No model invocation" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;spacing=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1050" y="835" width="320" height="115" as="geometry"/></mxCell>
<mxCell id="outage" value="&lt;b&gt;Budget store unavailable&lt;/b&gt;&lt;br&gt;APIM denies with HTTP 503&lt;br&gt;No model invocation" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;spacing=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="645" width="280" height="115" as="geometry"/></mxCell>
<mxCell id="model" value="&lt;b&gt;6 · APIM → Foundry: one model call&lt;/b&gt;&lt;br&gt;Gateway managed identity&lt;br&gt;Model returns response and actual usage" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="445" y="1030" width="550" height="105" as="geometry"/></mxCell>
<mxCell id="settle" value="&lt;b&gt;7 · APIM → engine: settle actual cost&lt;/b&gt;&lt;br&gt;PostgreSQL uses the reserved price snapshot&lt;br&gt;Commit spending + release surplus reservation" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;spacing=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="445" y="1200" width="550" height="105" as="geometry"/></mxCell>
<mxCell id="pending" value="&lt;b&gt;Unknown usage or failed settlement&lt;/b&gt;&lt;br&gt;Keep funds reserved&lt;br&gt;Mark pending reconciliation&lt;br&gt;Admin verifies before reconciling" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;spacing=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1120" y="1190" width="290" height="130" as="geometry"/></mxCell>
<mxCell id="response" value="&lt;b&gt;8 · APIM returns the backend response&lt;/b&gt;&lt;br&gt;Budget request ID + settlement status headers&lt;br&gt;Admin refreshes Budgets to see the resulting balance" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;spacing=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="445" y="1370" width="550" height="110" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#35556f;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="jwt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#35556f;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="jwt" target="precheck"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#35556f;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="precheck" target="reserve"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e4" value="Read / check inside the transaction" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#35556f;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="reserve" target="decision"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e5" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#35556f;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="decision" target="deny"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e6" value="Unavailable" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#35556f;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="reserve" target="outage"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e7" value="Yes · commit reservation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#35556f;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="decision" target="model"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e8" value="Actual provider usage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#35556f;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="model" target="settle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e9" value="Settled" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#35556f;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="settle" target="response"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e10" value="Usage uncertain" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#35556f;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="model" target="pending"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1265" y="1082"/></Array></mxGeometry></mxCell>
<mxCell id="e11" value="Commit&lt;br&gt;unconfirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#35556f;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="settle" target="pending"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e12" value="Pending status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#35556f;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="pending" target="response"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1210" y="1425"/></Array></mxGeometry></mxCell>
<mxCell id="notes" value="&lt;b&gt;$50/month example:&lt;/b&gt; reserve $0.06 → actual cost $0.002 → spent $0.002, reserved $0, remaining $49.998.&lt;br&gt;Figures are illustrative. A request can be blocked before exactly $50 is spent if the remainder cannot cover its maximum cost.&lt;br&gt;Identity/access failures also stop before inference. Separate asynchronous analytics does not authorize dollar spending.&lt;br&gt;Backend timeouts retain funds; the APIM error response carries the budget request ID." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#243746;" vertex="1" parent="1"><mxGeometry x="60" y="1530" width="1320" height="115" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
